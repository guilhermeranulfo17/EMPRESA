# ---------------------------------------------------------------------------
# Vendas Orkestra: variáveis de ambiente. Copie para .env.local (nunca versione .env.local).
# Local: os valores saem de `pnpm exec supabase status` depois de `pnpm db:start`.
# ---------------------------------------------------------------------------

# Supabase (públicas: podem ir para o navegador; as tabelas não aceitam a chave anon)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-anon-key

# Conexão do servidor com o banco (SECRETA). Na Vercel: string do pooler, modo transação, porta 6543.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Quem pode entrar, separados por vírgula. Vazio = ninguém entra.
# Local: gui@vendas.local (senha vendas12345, criada pelo supabase/seed.sql).
VENDAS_EMAILS=gui@vendas.local

# IA do assistente (só no servidor). Provedor: claude (padrão) | gemini | simulado (resposta fixa, testes).
VENDAS_IA_PROVEDOR=claude
# Opcional. Padrão: claude-sonnet-5-5 (Claude) ou gemini-3.8-flash (Gemini).
VENDAS_IA_MODELO=
# Chave do provedor escolhido (SECRETA). Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Versão do prompt: lê prompts/copiloto.<versao>.md. Padrão v3.
VENDAS_PROMPT_VERSAO=v3
